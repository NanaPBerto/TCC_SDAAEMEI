<input type="hidden" id="usuario-id" value="{{usuario.id}}">
<input type="hidden" id="usuario-tipo" value="{{usuario.tipo}}">

<div class="atividade-detalhada-card my-5">
  <div class="atividade-detalhada-titulo">{{atividade.nome}}</div>
  <div class="atividade-detalhada-top">
    <div class="atividade-detalhada-avatar">
      {{#if atividade.desenvolvedor.imagem}}
        <img src="{{atividade.desenvolvedor.imagem}}" alt="Imagem do desenvolvedor" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
      {{else}}
        <i class="fas fa-user"></i>
      {{/if}}
    </div>
    <div>
      <div class="atividade-detalhada-dev">Desenvolvedor: {{atividade.desenvolvedorNome}}</div>
      <div class="atividade-detalhada-badges">
        <span class="atividade-detalhada-badge">
          <i class="fas fa-tag"></i>
          {{#each atividade.tipos}}
            {{nome}}{{#unless @last}}, {{/unless}}
          {{/each}}
        </span>
        <span class="atividade-detalhada-badge"><i class="fas fa-users"></i> {{atividade.vagas}} integrantes</span>
        <span class="atividade-detalhada-badge"><i class="fas fa-clock"></i> {{atividade.duracao}}</span>
        <span class="atividade-detalhada-badge"><i class="fas fa-child"></i> 
          {{#if atividade.faixaEtaria}}{{atividade.faixaEtaria.nome}}{{else}}Berçario III{{/if}}
        </span>
      </div>
    </div>
  </div>
  <div class="atividade-detalhada-content">
    <div class="atividade-detalhada-imgbox">
      {{#if atividade.imagem}}
        <img src="{{atividade.imagem}}" alt="Imagem da atividade">
      {{else}}
        <i class="fas fa-music fa-3x" style="color: var(--primary-light);"></i>
      {{/if}}
    </div>
    <div class="atividade-detalhada-imgbox">
      {{#if atividade.video}}
        <video src="{{atividade.video}}" alt="Video da atividade" controls="default" >
      {{else}}
        <i class="fas fa-music fa-3x" style="color: var(--primary-light);"></i>
      {{/if}}
    </div>
    <div class="atividade-detalhada-partitura">
      {{#if atividade.partitura}}
        <a href="{{atividade.partitura}}" target="_blank" class="btn btn-outline-primary btn-sm" style="color: white;">
          <i class="fas fa-file-alt me-2"></i>Visualizar Partitura
        </a>
      {{else}}
        <span style="color: var(--primary-light);">Sem partitura</span>
      {{/if}}
    </div>
    <div class="atividade-detalhada-audio">
      {{#if atividade.musica}}
        <audio controls class="w-100">
          <source src="{{atividade.musica}}">
          Seu navegador não suporta o elemento de áudio.
        </audio>
      {{else}}
        <span style="color: var(--primary-light);">Sem áudio</span>
      {{/if}}
    </div>
  </div>
  <div class="atividade-detalhada-info">
    <div class="atividade-detalhada-info-col">
      <strong>Descrição:</strong>
      <div>{{atividade.descricao}}</div>
    </div>
    <div class="atividade-detalhada-info-col">
      <strong>Objetivo:</strong>
      <div>{{atividade.objetivo}}</div>
    </div>
    <div class="atividade-detalhada-info-col">
      <strong>Indicação:</strong>
      <div>{{atividade.indicacao}}</div>
    </div>
    <div class="atividade-detalhada-info-col">
      <strong>Recursos:</strong>
      <div>{{atividade.recursos}}</div>
    </div>
    <div class="atividade-detalhada-info-col">
      <strong>Condições:</strong>
      <div>{{atividade.condicoes}}</div>
    </div> 
      {{#if atividade.obs}}
        <div class="atividade-detalhada-obs"><strong>Obs:</strong> {{atividade.obs}}</div>
      {{/if}}
  </div>
</div>

<script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Verificar se estamos em uma página de atividade individual
    const atividadeId = '{{atividade.id}}';
    const usuarioId = '{{#if session.usuario}}{{session.usuario.id}}{{/if}}';
    
    if (atividadeId && usuarioId && atividadeId !== '') {
        console.log('📝 Registrando visualização da atividade:', atividadeId, 'para usuário:', usuarioId);
        
        // Dados da atividade para o histórico
        const atividadeData = {
            titulo: '{{atividade.nome}}',
            objetivo: '{{atividade.objetivo}}',
            imagem: '{{atividade.imagem}}',
            tipos: JSON.parse('{{{json atividade.tipos}}}')
        };
        
        // Registrar visualização
        if (typeof registrarVisualizacao === 'function') {
            registrarVisualizacao(atividadeId, atividadeData);
        } else {
            console.error('❌ Função registrarVisualizacao não encontrada');
            // Fallback: registrar manualmente
            registrarVisualizacaoManual(atividadeId, atividadeData);
        }
    }
});

// Fallback function
function registrarVisualizacaoManual(atividadeId, atividadeData) {
    try {
        const usuarioId = '{{#if session.usuario}}{{session.usuario.id}}{{/if}}';
        if (!usuarioId) return;
        
        const chaveHistorico = `historicoAtividades_${usuarioId}`;
        const historicoRaw = localStorage.getItem(chaveHistorico);
        const historico = historicoRaw ? JSON.parse(historicoRaw) : [];
        
        // Remover se já existir
        const historicoFiltrado = historico.filter(item => item.id != atividadeId);
        
        // Adicionar no início
        historicoFiltrado.unshift({
            id: atividadeId,
            ...atividadeData,
            dataAcesso: new Date().toISOString(),
            usuarioId: usuarioId
        });
        
        // Manter apenas últimos 20
        const historicoLimitado = historicoFiltrado.slice(0, 20);
        localStorage.setItem(chaveHistorico, JSON.stringify(historicoLimitado));
        
        console.log('✅ Visualização registrada manualmente');
    } catch (error) {
        console.error('Erro no fallback:', error);
    }
}
</script>

