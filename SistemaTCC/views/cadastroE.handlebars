<div class="container cadastro-educador py-4">
  <div class="cadastro-container">
    <div class="cadastro-card">
      <div class="cadastro-header">
        <h1>
          <i class="fas fa-user-plus me-2"></i>Cadastro de Educador
        </h1>
        <p class="subtitle">Crie sua conta para acessar recursos educacionais</p>
      </div>

      <form action="/usuario/add" method="POST" enctype="multipart/form-data" class="cadastro-form">
      <!-- Avatar Upload -->
            {{#if alert}}
<div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
  <i class="fas fa-exclamation-triangle me-2"></i>
  {{alert}}
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}
      <div class="avatar-upload mb-4">
        <div class="avatar-preview">
          <div class="avatar-placeholder" id="avatarPreviewE">
            <i class="fas fa-camera"></i>
          </div>
          <label class="avatar-edit-btn" for="fotoP">
            <i class="fas fa-camera"></i>
            <input type="file" id="fotoP" name="imagem" accept="image/*" onchange="previewAvatar(event, 'avatarPreviewE')">
          </label>
        </div> 
        <small class="text-muted">Foto de Perfil</small>
      </div>
      <!-- Informações Pessoais -->
      <fieldset class="mb-4 border-0">
        <input type="hidden" name="tipo" value="educador">
        <div class="row g-3">
          <!-- Nome -->
          <div class="col-md-6">
            <label for="nome" class="form-label">Nome*</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-user"></i></span>
              <input type="text" class="form-control" id="nome" name="nome" value="{{nome}}" placeholder="Seu nome completo" maxlength="50" required>
            </div> 
          </div>
          <!-- Usuário -->
          <div class="col-md-6">
            <label for="usuario" class="form-label">Usuário*</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-at"></i></span>
              <input type="text" class="form-control" id="usuario" name="usuario" maxlength="20" placeholder="Nome de usuário único" required>
            </div>
          </div>
<!-- Senha -->
<div class="col-md-6">
    <label for="senha" class="form-label">Senha*</label>
    <div class="input-group">
        <span class="input-group-text"><i class="fas fa-lock"></i></span>
        <input type="password" class="form-control" id="senha" name="senha" minlength="8" maxlength="100" placeholder="Mínimo 8 caracteres" required>
        <button type="button" class="btn btn-outline-secondary" id="toggleSenhaCadastro">
            <i class="fas fa-eye"></i>
        </button>
    </div>
    <small class="text-muted ms-2">Use letras, números e símbolos</small>
</div>
          <!-- Email -->
          <div class="col-md-6">
            <label for="email" class="form-label">Email*</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-envelope"></i></span>
              <input type="email" class="form-control" id="email" name="email" maxlength="50" placeholder="seu@email.com" required>
            </div>
          </div>
          <!-- UF -->
          <div class="col-md-6">
            <label for="uf" class="form-label">UF*</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
              <select class="form-select" id="uf" name="uf" required>
                <option value="">Selecione</option>
                <option value="AC">AC</option>
                <option value="AL">AL</option>
                <option value="AP">AP</option>
                <option value="AM">AM</option>
                <option value="BA">BA</option>
                <option value="CE">CE</option>
                <option value="DF">DF</option>
                <option value="ES">ES</option>
                <option value="GO">GO</option>
                <option value="MA">MA</option>
                <option value="MT">MT</option>
                <option value="MS">MS</option>
                <option value="MG">MG</option>
                <option value="PA">PA</option>
                <option value="PB">PB</option>
                <option value="PR">PR</option>
                <option value="PE">PE</option>
                <option value="PI">PI</option>
                <option value="RJ">RJ</option>
                <option value="RN">RN</option>
                <option value="RS">RS</option>
                <option value="RO">RO</option>
                <option value="RR">RR</option>
                <option value="SC">SC</option>
                <option value="SP">SP</option>
                <option value="SE">SE</option>
                <option value="TO">TO</option>
              </select>
            </div>
          </div>
          <!-- Cidade -->
          <div class="col-md-6">
            <label for="cidade" class="form-label">Cidade*</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
              <input type="text" class="form-control" id="cidade" name="cidade" placeholder="Sua cidade" maxlength="50" required>
            </div>
          </div>
        </div>
      </fieldset>
      <!-- Termos e Botões -->
      <div class="d-flex justify-content-end gap-3">
        <a href="login.html" class="btn btn-outline-secondary">
          <i class="fas fa-times-circle me-2"></i>Cancelar
        </a>
        <button type="submit" class="btn btn-outline-secondary" id="btnC">
          <i class="fas fa-user-plus me-2"></i>Criar
        </button>
      </div>

    </form>
  </div>
</div>

<script>
  // Mostrar/ocultar senha no cadastro
document.addEventListener('DOMContentLoaded', function() {
    const toggleSenhaCadastro = document.getElementById('toggleSenhaCadastro');
    const senhaInputCadastro = document.getElementById('senha');
    
    if (toggleSenhaCadastro && senhaInputCadastro) {
        const eyeIcon = toggleSenhaCadastro.querySelector('i');
        
        toggleSenhaCadastro.addEventListener('click', function() {
            const type = senhaInputCadastro.getAttribute('type') === 'password' ? 'text' : 'password';
            senhaInputCadastro.setAttribute('type', type);
            
            if (type === 'text') {
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        });
    }
});
</script>
