    <!-- Conteúdo Principal -->
    <main class="container mt-4" style="margin-left: 70px; padding-top: 70px;">
        {{{body}}}
    </main>

     <!-- Script de inicialização do histórico -->
    <script>
    // Sistema de registro automático de visualizações
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🎵 Musicoteca - Inicializando sistema de histórico...');
        
        const usuarioId = document.body.dataset.usuarioId;
        const usuarioTipo = document.body.dataset.usuarioTipo;
        
        if (usuarioId && usuarioTipo) {
            console.log(`👤 Usuário detectado: ${usuarioId} (${usuarioTipo})`);
            localStorage.setItem('usuarioAtualId', usuarioId);
            localStorage.setItem('usuarioAtualTipo', usuarioTipo);
        }

        // REGISTRO AUTOMÁTICO DE VISUALIZAÇÃO
        registrarVisualizacaoAutomatica();
    });

    // Função para registro automático de visualização
    async function registrarVisualizacaoAutomatica() {
        const urlPath = window.location.pathname;
        
        // Verificar se é uma página de atividade individual
        const match = urlPath.match(/\/atividade\/(\d+)/);
        if (!match) return;
        
        const atividadeId = match[1];
        const usuarioId = localStorage.getItem('usuarioAtualId');
        
        if (!usuarioId) {
            console.warn('⚠️ Não é possível registrar visualização: usuário não identificado');
            return;
        }

        console.log(`📝 Tentando registrar visualização da atividade ${atividadeId} para usuário ${usuarioId}`);

        // Aguardar um pouco para a página carregar completamente
        setTimeout(async () => {
            try {
                // Tentar usar a função global se disponível
                if (typeof window.registrarVisualizacao === 'function') {
                    // Coletar dados da atividade da página
                    const atividadeData = coletarDadosAtividade();
                    window.registrarVisualizacao(atividadeId, atividadeData);
                    console.log('✅ Visualização registrada via função global');
                } else {
                    // Fallback: registrar diretamente
                    await registrarVisualizacaoDireta(atividadeId);
                }
            } catch (error) {
                console.error('❌ Erro no registro automático:', error);
                // Tentar fallback
                await registrarVisualizacaoDireta(atividadeId);
            }
        }, 500);
    }

    // Coletar dados da atividade da página
    function coletarDadosAtividade() {
        try {
            // Tentar obter dados de elementos da página
            const tituloElement = document.querySelector('h1, h2, .atividade-titulo, [data-atividade-titulo]');
            const objetivoElement = document.querySelector('.objetivo, .atividade-objetivo, [data-atividade-objetivo]');
            const imagemElement = document.querySelector('.atividade-imagem, [data-atividade-imagem] img, .card img');
            
            return {
                titulo: tituloElement ? tituloElement.textContent.trim() : 'Atividade ' + window.location.pathname.split('/').pop(),
                objetivo: objetivoElement ? objetivoElement.textContent.trim() : 'Atividade musical educativa',
                imagem: imagemElement ? imagemElement.src : null
            };
        } catch (error) {
            console.warn('⚠️ Não foi possível coletar dados detalhados da atividade');
            return {
                titulo: 'Atividade Musical',
                objetivo: 'Atividade musical educativa',
                imagem: null
            };
        }
    }

    // Fallback: registro direto no localStorage
    async function registrarVisualizacaoDireta(atividadeId) {
        try {
            const usuarioId = localStorage.getItem('usuarioAtualId');
            if (!usuarioId) return;

            const chaveHistorico = `historicoAtividades_${usuarioId}`;
            const historicoRaw = localStorage.getItem(chaveHistorico);
            const historico = historicoRaw ? JSON.parse(historicoRaw) : [];
            
            // Verificar se já existe
            const existe = historico.find(item => item.id == atividadeId);
            if (existe) {
                console.log('📋 Atividade já está no histórico, atualizando data...');
                // Atualizar data de acesso
                const historicoAtualizado = historico.filter(item => item.id != atividadeId);
                historicoAtualizado.unshift({
                    ...existe,
                    dataAcesso: new Date().toISOString()
                });
                localStorage.setItem(chaveHistorico, JSON.stringify(historicoAtualizado));
            } else {
                console.log('➕ Adicionando nova atividade ao histórico...');
                // Buscar dados da atividade via API
                const atividadeData = await buscarDadosAtividade(atividadeId);
                
                historico.unshift({
                    id: atividadeId,
                    titulo: atividadeData.titulo || 'Atividade ' + atividadeId,
                    objetivo: atividadeData.objetivo || 'Atividade musical educativa',
                    imagem: atividadeData.imagem || null,
                    dataAcesso: new Date().toISOString(),
                    usuarioId: usuarioId
                });
                
                // Manter apenas últimos 20
                const historicoLimitado = historico.slice(0, 20);
                localStorage.setItem(chaveHistorico, JSON.stringify(historicoLimitado));
            }
            
            console.log('✅ Visualização registrada diretamente no localStorage');
        } catch (error) {
            console.error('❌ Erro no registro direto:', error);
        }
    }

    // Buscar dados da atividade via API
    async function buscarDadosAtividade(atividadeId) {
        try {
            const response = await fetch(`/api/atividades/${atividadeId}`);
            if (response.ok) {
                const data = await response.json();
                return {
                    titulo: data.nome || data.titulo,
                    objetivo: data.objetivo,
                    imagem: data.imagem
                };
            }
        } catch (error) {
            console.warn('⚠️ Não foi possível buscar dados da atividade via API');
        }
        
        // Fallback
        return {
            titulo: 'Atividade ' + atividadeId,
            objetivo: 'Atividade musical educativa',
            imagem: null
        };
    }

    // Função auxiliar para verificar estado do histórico
    function verificarEstadoHistorico() {
        const usuarioId = localStorage.getItem('usuarioAtualId');
        const chaveHistorico = usuarioId ? `historicoAtividades_${usuarioId}` : 'historicoAtividades_global';
        const historico = localStorage.getItem(chaveHistorico);
        
        console.log('🔍 Estado atual do histórico:');
        console.log('- Usuário ID:', usuarioId);
        console.log('- Chave do histórico:', chaveHistorico);
        console.log('- Itens no histórico:', historico ? JSON.parse(historico).length : 0);
        
        if (historico) {
            const atividades = JSON.parse(historico);
            console.log('- Atividades:', atividades.map(a => ({ 
                id: a.id, 
                titulo: a.titulo,
                data: a.dataAcesso 
            })));
        }
        
        return historico ? JSON.parse(historico) : [];
    }

    // Função para forçar registro de visualização (para teste)
    function forcarRegistroVisualizacao(atividadeId) {
        const usuarioId = localStorage.getItem('usuarioAtualId');
        if (!usuarioId) {
            alert('Usuário não identificado!');
            return;
        }
        
        if (!atividadeId) {
            atividadeId = prompt('Digite o ID da atividade:');
            if (!atividadeId) return;
        }
        
        registrarVisualizacaoDireta(atividadeId).then(() => {
            alert(`Visualização da atividade ${atividadeId} registrada!`);
            verificarEstadoHistorico();
        });
    }

    // Adicionar ao window para acesso via console
    window.verificarEstadoHistorico = verificarEstadoHistorico;
    window.forcarRegistroVisualizacao = forcarRegistroVisualizacao;
    window.registrarVisualizacaoDireta = registrarVisualizacaoDireta;
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/scripts/historico.js"></script> 
    <script src="/public/scripts/atividade.js"></script> 
    <script src="/public/scripts/cadastros.js"></script>
    <script src="/public/scripts/escolher.js"></script>
    <script src="/public/scripts/menuLateral.js"></script>
    <script src="/public/scripts/isOwnProfile.js"></script>
    <script src="/public/scripts/sugeridas.js"></script>
    <script src="/public/scripts/pesquisas.js"></script>
</body>
</html>